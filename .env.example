# Copia este archivo como .env y coloca las credenciales reales.
# NUNCA subas el archivo .env al repositorio.
#
# Turso -> tu base de datos -> Connect / CLI:
#   turso db show <nombre-de-la-base> --url
#   turso db tokens create <nombre-de-la-base>

TURSO_DATABASE_URL="libsql://nombre-de-la-base-tu-organizacion.turso.io"
TURSO_AUTH_TOKEN="pega-aqui-tu-token-de-turso"
